<!DOCTYPE html>
<html lang="ko">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Job Crawler — {{ run_date }}</title>
<link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@400;700;900&family=DM+Sans:wght@300;400;500&display=swap" rel="stylesheet">
<style>
  :root {
    --bg:       #0a1628;
    --bg-mid:   #1a2f50;
    --blue:     #009edb;
    --gold:     #c9a84c;
    --white:    #ffffff;
    --muted:    rgba(255,255,255,0.45);
    --border:   rgba(255,255,255,0.08);
    --intern:   #66bb6a;
    --pro:      #42a5f5;
    --con:      #ba68c8;
    --other:    #ffa726;
  }
  * { margin:0; padding:0; box-sizing:border-box; }
  body { font-family:'DM Sans',sans-serif; background:var(--bg); color:var(--white); min-height:100vh; }

  /* ── HERO ───────────────────────────────────────── */
  .hero {
    background: linear-gradient(135deg, var(--bg) 0%, var(--bg-mid) 60%, #1a3a6e 100%);
    padding: 56px 40px 44px;
    position: relative; overflow: hidden;
  }
  .hero::before {
    content:''; position:absolute; top:-80px; right:-80px;
    width:400px; height:400px;
    background: radial-gradient(circle, rgba(0,158,219,.18) 0%, transparent 70%);
  }
  .hero-inner { max-width:1100px; margin:0 auto; position:relative; z-index:1; }
  .brand { display:flex; align-items:center; gap:12px; margin-bottom:28px; }
  .brand-icon { width:48px; height:48px; border:2px solid var(--blue); border-radius:50%; display:flex; align-items:center; justify-content:center; font-size:20px; }
  .brand-text { font-size:11px; letter-spacing:3px; text-transform:uppercase; color:var(--blue); }
  .hero h1 { font-family:'Playfair Display',serif; font-size:clamp(32px,5vw,58px); font-weight:900; line-height:1.08; margin-bottom:10px; }
  .hero h1 span { color:var(--gold); }
  .hero-meta { font-size:13px; color:var(--muted); margin-bottom:32px; }
  .stats { display:flex; gap:28px; flex-wrap:wrap; }
  .stat { display:flex; flex-direction:column; gap:2px; }
  .stat-n { font-family:'Playfair Display',serif; font-size:26px; font-weight:700; color:var(--gold); }
  .stat-l { font-size:10px; color:var(--muted); letter-spacing:1.5px; text-transform:uppercase; }
  .vline { width:1px; background:var(--border); align-self:stretch; }

  /* ── FILTER BAR ─────────────────────────────────── */
  .filter-bar {
    background: rgba(255,255,255,.04);
    border-top:1px solid var(--border); border-bottom:1px solid var(--border);
    padding: 16px 40px;
  }
  .filter-inner { max-width:1100px; margin:0 auto; display:flex; gap:8px; flex-wrap:wrap; align-items:center; }
  .f-label { font-size:10px; color:var(--muted); letter-spacing:2px; text-transform:uppercase; margin-right:4px; }
  .f-btn { border:none; padding:6px 14px; border-radius:20px; font-family:'DM Sans',sans-serif; font-size:11px; font-weight:600; cursor:pointer; letter-spacing:.3px; transition:all .2s; }
  .f-btn.all { background:var(--blue); color:#fff; }
  .f-btn.site { background:rgba(0,158,219,.15); color:#7ecff5; border:1px solid rgba(0,158,219,.3); }
  .f-btn:hover { filter:brightness(1.2); transform:translateY(-1px); }
  .f-btn.active { box-shadow:0 0 0 2px #fff; }

  /* ── TAGS BAR (keywords / locations) ────────────── */
  .tags-bar { background:rgba(255,255,255,.02); padding:12px 40px; border-bottom:1px solid var(--border); }
  .tags-inner { max-width:1100px; margin:0 auto; display:flex; gap:6px; flex-wrap:wrap; align-items:center; }
  .tag-label { font-size:10px; color:var(--muted); letter-spacing:2px; text-transform:uppercase; margin-right:4px; }
  .tag { font-size:11px; padding:3px 10px; border-radius:12px; background:rgba(255,255,255,.07); color:rgba(255,255,255,.6); }
  .tag.kw { background:rgba(0,158,219,.12); color:#7ecff5; }
  .tag.loc { background:rgba(201,168,76,.12); color:#f0d98a; }

  /* ── MAIN ───────────────────────────────────────── */
  .main { max-width:1100px; margin:0 auto; padding:44px 40px; }

  /* Section header */
  .sec-hdr { display:flex; align-items:center; gap:12px; margin:44px 0 20px; }
  .sec-hdr:first-child { margin-top:0; }
  .sec-dot { width:9px; height:9px; border-radius:50%; flex-shrink:0; }
  .sec-title { font-family:'Playfair Display',serif; font-size:19px; font-weight:700; }
  .sec-count { font-size:11px; color:var(--muted); }
  .sec-line { flex:1; height:1px; background:var(--border); }

  /* Cards grid */
  .grid { display:grid; grid-template-columns:repeat(auto-fill,minmax(310px,1fr)); gap:14px; }

  .card {
    background:rgba(255,255,255,.04);
    border:1px solid var(--border);
    border-radius:12px; padding:22px;
    position:relative; overflow:hidden;
    display:flex; flex-direction:column; gap:12px;
    transition:all .25s ease; cursor:default;
    animation: fadeUp .4s ease both;
  }
  @keyframes fadeUp { from{opacity:0;transform:translateY(14px)} to{opacity:1;transform:translateY(0)} }
  .card:hover { background:rgba(255,255,255,.08); border-color:rgba(255,255,255,.18); transform:translateY(-3px); box-shadow:0 12px 36px rgba(0,0,0,.4); }

  .card-bar { position:absolute; top:0; left:0; right:0; height:3px; border-radius:12px 12px 0 0; }
  .card-bar.intern     { background:linear-gradient(90deg,#2e7d32,var(--intern)); }
  .card-bar.pro        { background:linear-gradient(90deg,#1565c0,var(--pro)); }
  .card-bar.consultant { background:linear-gradient(90deg,#6a1b9a,var(--con)); }
  .card-bar.other      { background:linear-gradient(90deg,#e65100,var(--other)); }

  .card-top { display:flex; justify-content:space-between; align-items:flex-start; gap:8px; }
  .badge { font-size:10px; font-weight:600; letter-spacing:1.2px; text-transform:uppercase; padding:3px 9px; border-radius:10px; white-space:nowrap; flex-shrink:0; }
  .badge.intern     { background:rgba(102,187,106,.2); color:#81c784; }
  .badge.pro        { background:rgba(66,165,245,.2); color:#64b5f6; }
  .badge.consultant { background:rgba(186,104,200,.2); color:#ce93d8; }
  .badge.other      { background:rgba(255,167,38,.2); color:#ffcc80; }

  .card-id { font-size:10px; color:rgba(255,255,255,.22); font-family:monospace; }
  .card-title { font-family:'Playfair Display',serif; font-size:16px; font-weight:700; line-height:1.35; }
  .card-source { font-size:10px; color:rgba(255,255,255,.3); letter-spacing:1px; text-transform:uppercase; margin-top:-4px; }

  .meta { display:flex; flex-direction:column; gap:6px; }
  .meta-row { display:flex; align-items:flex-start; gap:7px; font-size:12px; }
  .meta-icon { flex-shrink:0; opacity:.55; margin-top:1px; }
  .meta-text { color:rgba(255,255,255,.55); line-height:1.4; }
  .meta-text strong { color:rgba(255,255,255,.8); font-weight:500; }

  .kw-pills { display:flex; gap:4px; flex-wrap:wrap; }
  .kw-pill { font-size:10px; padding:2px 8px; border-radius:8px; background:rgba(0,158,219,.15); color:#7ecff5; }

  .card-footer { display:flex; justify-content:space-between; align-items:center; padding-top:10px; border-top:1px solid var(--border); margin-top:auto; }
  .deadline { font-size:11px; color:var(--muted); }
  .deadline .date { font-weight:500; }
  .deadline.urgent .date { color:#ef9a9a; }
  .deadline.soon   .date { color:#ffcc80; }
  .deadline.ok     .date { color:rgba(255,255,255,.7); }

  .view-btn { font-size:10px; font-weight:600; letter-spacing:1px; text-transform:uppercase; color:var(--blue); text-decoration:none; padding:5px 13px; border:1px solid rgba(0,158,219,.35); border-radius:16px; transition:all .2s; white-space:nowrap; }
  .view-btn:hover { background:var(--blue); color:#fff; border-color:var(--blue); }

  /* No results */
  .empty { text-align:center; padding:60px 20px; color:var(--muted); font-size:14px; }

  /* Archive nav */
  .archive { max-width:1100px; margin:0 auto; padding:0 40px 48px; }
  .archive h3 { font-size:13px; color:var(--muted); letter-spacing:1.5px; text-transform:uppercase; margin-bottom:12px; }
  .archive-links { display:flex; gap:8px; flex-wrap:wrap; }
  .archive-link { font-size:12px; padding:5px 14px; border-radius:16px; background:rgba(255,255,255,.05); color:rgba(255,255,255,.5); text-decoration:none; border:1px solid var(--border); transition:all .2s; }
  .archive-link:hover { background:rgba(255,255,255,.1); color:#fff; }
  .archive-link.current { background:rgba(0,158,219,.2); color:#7ecff5; border-color:rgba(0,158,219,.4); }

  /* Footer */
  footer { border-top:1px solid var(--border); padding:28px 40px; text-align:center; }
  .foot-note { font-size:11px; color:rgba(255,255,255,.2); letter-spacing:.5px; }
  .foot-note a { color:var(--blue); text-decoration:none; }

  @media(max-width:680px) {
    .hero,.filter-bar,.tags-bar,.main,.archive,footer { padding-left:16px; padding-right:16px; }
    .stats { gap:16px; }
    .grid { grid-template-columns:1fr; }
  }
</style>
</head>
<body>

<!-- HERO -->
<header class="hero">
  <div class="hero-inner">
    <div class="brand">
      <div class="brand-icon">🌐</div>
      <span class="brand-text">Job Crawler — Auto Daily Report</span>
    </div>
    <h1>채용 공고 리포트<br><span>{{ run_date }}</span></h1>
    <p class="hero-meta">
      검색 사이트: {{ sites | join(", ") }} &nbsp;·&nbsp;
      수집 시각: {{ run_time }}
    </p>
    <div class="stats">
      <div class="stat"><span class="stat-n">{{ total_count }}</span><span class="stat-l">Total</span></div>
      <div class="vline"></div>
      {% for site, cnt in site_counts.items() %}
      <div class="stat"><span class="stat-n">{{ cnt }}</span><span class="stat-l">{{ site }}</span></div>
      <div class="vline"></div>
      {% endfor %}
      {% for cat, cnt in category_counts.items() %}
      <div class="stat"><span class="stat-n">{{ cnt }}</span><span class="stat-l">{{ cat }}</span></div>
      {% if not loop.last %}<div class="vline"></div>{% endif %}
      {% endfor %}
    </div>
  </div>
</header>

<!-- FILTER BAR -->
<div class="filter-bar">
  <div class="filter-inner">
    <span class="f-label">Filter</span>
    <button class="f-btn all active" onclick="filterBy('all',this)">전체 보기</button>
    {% for site in sites %}
    <button class="f-btn site" onclick="filterBy('{{ site | lower | replace(' ','_') }}',this)">{{ site }}</button>
    {% endfor %}
  </div>
</div>

<!-- TAGS BAR -->
<div class="tags-bar">
  <div class="tags-inner">
    <span class="tag-label">키워드</span>
    {% for kw in keywords %}
    <span class="tag kw">{{ kw }}</span>
    {% endfor %}
    &nbsp;
    <span class="tag-label">근무지</span>
    {% for loc in locations %}
    <span class="tag loc">📍 {{ loc }}</span>
    {% endfor %}
    {% if not locations %}
    <span class="tag loc">📍 전체 지역</span>
    {% endif %}
  </div>
</div>

<!-- MAIN -->
<main class="main">

{% if total_count == 0 %}
  <div class="empty">
    <p>🔍 조건에 맞는 채용 공고를 찾지 못했습니다.</p>
    <p style="margin-top:8px;font-size:12px;">search_conditions.yaml의 키워드, 근무지, 마감일 설정을 확인해 주세요.</p>
  </div>
{% else %}

  {% for category, jobs in grouped_jobs.items() %}
  {% set cat_key = "intern" if "인턴" in category else ("pro" if "전문" in category else ("consultant" if "컨설" in category else "other")) %}

  <div class="sec-hdr">
    <div class="sec-dot" style="background:var(--{{ cat_key if cat_key != 'pro' else 'pro' }})"></div>
    <h2 class="sec-title">{{ category }}</h2>
    <span class="sec-count">· {{ jobs | length }}개 공고</span>
    <div class="sec-line"></div>
  </div>

  <div class="grid" data-category="{{ cat_key }}">
  {% for job in jobs %}
  {% set days_left = job.days_left %}
  {% set urgency = "urgent" if days_left is not none and days_left <= 7 else ("soon" if days_left is not none and days_left <= 21 else "ok") %}

  <div class="card" data-site="{{ job.source_site | lower | replace(' ','_') }}" data-cat="{{ cat_key }}">
    <div class="card-bar {{ cat_key }}"></div>

    <div class="card-top">
      <span class="badge {{ cat_key }}">{{ job.category or cat_key }}</span>
      <span class="card-id">#{{ job.job_id }}</span>
    </div>

    <div>
      <div class="card-title">{{ job.title }}</div>
      <div class="card-source">{{ job.source_site }}</div>
    </div>

    <div class="meta">
      <div class="meta-row">
        <span class="meta-icon">🏛️</span>
        <span class="meta-text"><strong>{{ job.organization }}</strong></span>
      </div>
      <div class="meta-row">
        <span class="meta-icon">📍</span>
        <span class="meta-text">{{ job.location }}</span>
      </div>
      {% if job.date_posted %}
      <div class="meta-row">
        <span class="meta-icon">📅</span>
        <span class="meta-text">게시일: {{ job.date_posted }}</span>
      </div>
      {% endif %}
    </div>

    {% if job.keywords_matched %}
    <div class="kw-pills">
      {% for kw in job.keywords_matched %}
      <span class="kw-pill">{{ kw }}</span>
      {% endfor %}
    </div>
    {% endif %}

    <div class="card-footer">
      <div class="deadline {{ urgency }}">
        마감
        <span class="date">
          {{ job.deadline or "미정" }}
          {% if days_left is not none %}
            (D-{{ days_left }})
          {% endif %}
        </span>
      </div>
      <a class="view-btn" href="{{ job.url }}" target="_blank">지원하기 →</a>
    </div>
  </div>

  {% endfor %}
  </div><!-- /grid -->
  {% endfor %}

{% endif %}
</main>

<!-- ARCHIVE NAV -->
{% if archive_files %}
<div class="archive">
  <h3>📁 이전 리포트</h3>
  <div class="archive-links">
    {% for fname in archive_files %}
    <a class="archive-link {% if fname == current_file %}current{% endif %}"
       href="{{ fname }}">{{ fname | replace('jobs_','') | replace('.html','') }}</a>
    {% endfor %}
  </div>
</div>
{% endif %}

<!-- FOOTER -->
<footer>
  <p class="foot-note">
    자동 생성 — Job Crawler &nbsp;·&nbsp;
    {% for site_cfg in site_configs %}
    <a href="{{ site_cfg.url }}" target="_blank">{{ site_cfg.name }}</a>{% if not loop.last %}, {% endif %}
    {% endfor %}
    &nbsp;·&nbsp; {{ run_date }} {{ run_time }}
  </p>
</footer>

<script>
function filterBy(type, btn) {
  document.querySelectorAll('.f-btn').forEach(b => b.classList.remove('active'));
  btn.classList.add('active');

  document.querySelectorAll('.card').forEach(card => {
    if (type === 'all') {
      card.style.display = '';
    } else {
      card.style.display = card.dataset.site === type ? '' : 'none';
    }
  });

  // 섹션 헤더 표시/숨김
  document.querySelectorAll('.sec-hdr').forEach(hdr => {
    const grid = hdr.nextElementSibling;
    if (!grid) return;
    const visible = Array.from(grid.querySelectorAll('.card'))
                         .some(c => c.style.display !== 'none');
    hdr.style.display = visible ? '' : 'none';
    grid.style.display = visible ? '' : 'none';
  });
}
</script>
</body>
</html>
